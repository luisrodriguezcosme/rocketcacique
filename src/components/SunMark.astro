---
// Taíno sun petroglyph, simplified: spiral-eyed sun with eight rays.
const { size = 34 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 100 100"
  role="img"
  aria-label="Taíno sun petroglyph"
  fill="none"
  stroke="var(--sun)"
  stroke-width="7"
  stroke-linecap="round"
>
  <circle cx="50" cy="50" r="24" />
  <circle cx="41" cy="46" r="3.5" fill="var(--sun)" stroke="none" />
  <circle cx="59" cy="46" r="3.5" fill="var(--sun)" stroke="none" />
  <path d="M42 59 q8 6 16 0" />
  <line x1="50" y1="14" x2="50" y2="4" />
  <line x1="50" y1="86" x2="50" y2="96" />
  <line x1="14" y1="50" x2="4" y2="50" />
  <line x1="86" y1="50" x2="96" y2="50" />
  <line x1="25" y1="25" x2="18" y2="18" />
  <line x1="75" y1="25" x2="82" y2="18" />
  <line x1="25" y1="75" x2="18" y2="82" />
  <line x1="75" y1="75" x2="82" y2="82" />
</svg>
