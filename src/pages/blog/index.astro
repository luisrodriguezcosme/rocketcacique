---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Blog — Rocket Cacique">
  <h1>Blog</h1>
  <p class="quiet">
    Notes on infrastructure, AI tooling, side projects, and a long career —
    also as <a href="/rss.xml">RSS</a>.
  </p>
  <ul class="ruled">
    {posts.map((p) => (
      <li>
        <span class="row">
          <a href={`/blog/${p.id}/`}>{p.data.title}</a>
          <span class="when">{fmt(p.data.date)}</span>
        </span>
        <span class="sub">{p.data.description}</span>
      </li>
    ))}
  </ul>
</Base>
